#!/bin/bash
#PBS -q gpuvolta
#PBS -P um09
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=100GB
#PBS -l walltime=24:00:00
#PBS -l storage=scratch/um09+gdata/dk92
#PBS -l jobfs=100GB
#PBS -N b1_wdmpnn_f5
#PBS -r y
set -euo pipefail
module load python3/3.12.1 cuda/12.0.0
source /home/659/hl4138/dmpnn-venv/bin/activate
cd /scratch/um09/hl4138/dmpnn
test -f metadata/splits/monomer_b_heldout.json || { echo 'Missing metadata/splits/monomer_b_heldout.json' >&2; exit 1; }
test -f metadata/splits/monomer_b_heldout_clustered.json || { echo 'Missing metadata/splits/monomer_b_heldout_clustered.json' >&2; exit 1; }
python scripts/python/run_wdmpnn_generalization.py --split_types monomer_b_heldout --folds 5 --targets 'EA vs SHE (eV)' --seed 42 --split_seed 42
